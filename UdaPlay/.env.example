# Copy this file to .env and add your own API keys.
OPENAI_API_KEY=xxx
TAVILY_API_KEY=xxx

# Optional: if you explicitly configure Chroma's OpenAI embedding function,
# set CHROMA_OPENAI_API_KEY. The starter app uses OpenAI embeddings directly.
CHROMA_OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
TAVILY_MAX_RESULTS=5
CHROMA_PATH=data/chroma_db
CHROMA_COLLECTION=udaplay_games
GAMES_DIR=starter/games
